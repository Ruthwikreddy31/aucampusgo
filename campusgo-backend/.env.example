DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusgo
DB_USERNAME=campusgo_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_USE_SSL=false

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=86400000
DOCUMENT_ENCRYPTION_KEY=replace-with-a-separate-32-plus-character-secret

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_ALLOWED_DOMAINS=anurag.edu.in
GOOGLE_ALLOW_MOCK_TOKENS=false

MAIL_USERNAME=replace-with-sender-email
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_ENABLED=true
OTP_EXPOSE_IN_RESPONSE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_PASSWORD=
DEMO_AGENT_PASSWORD=

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
PORT=8080
